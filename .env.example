# Default mode is demo-safe and does not call external models.
RAD_TRAINER_MODEL_MODE=demo

# Set to "hf" to use Hugging Face InferenceClient for the tutor.
RAD_TRAINER_TUTOR_PROVIDER=demo
HF_TOKEN=
RAD_TRAINER_HF_PROVIDER=nvidia

# Suggested small-model hackathon/NVIDIA model. You can swap for another Nemotron model.
RAD_TRAINER_NEMOTRON_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B-BF16

# Optional OpenAI-compatible local endpoint, for example vLLM or llama.cpp server.
RAD_TRAINER_OPENAI_BASE_URL=http://localhost:8000/v1
RAD_TRAINER_OPENAI_API_KEY=

# Local model hooks. These are intentionally optional for the demo.
RAD_TRAINER_CHEST_CLASSIFIER=xraydar
RAD_TRAINER_MEDICAL_VLM=google/medgemma-1.5-4b-it
RAD_TRAINER_ENABLE_SEGMENTATION=false
