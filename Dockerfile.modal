FROM ghcr.io/ggml-org/llama.cpp:server-cuda-b8772@sha256:3c1368d98e17df59068d4cccab2f86a8542a92e9c356dfcfbd26a3f964cb33ef AS llama-runtime

FROM nvidia/cuda:12.8.1-runtime-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/workspace/.venv \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    GRADIO_SERVER_NAME=0.0.0.0 \
    GRADIO_SERVER_PORT=7860 \
    RAD_TRAINER_MODEL_MODE=local \
    RAD_TRAINER_TUTOR_PROVIDER=llama \
    RAD_TRAINER_ENABLE_MEDICAL_VLM=true \
    RAD_TRAINER_CHEST_CLASSIFIER=xraydar \
    RAD_TRAINER_XRAYDAR_DEVICE=cuda \
    RAD_TRAINER_LLAMA_BASE_URL=http://127.0.0.1:8080/v1

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl git libcurl4 libgomp1 libssl3 python3 python3-venv python-is-python3 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=llama-runtime /app/llama-server /usr/local/bin/llama-server
COPY --from=llama-runtime /app/lib*.so* /usr/local/lib/
RUN ldconfig \
    && curl -sS https://bootstrap.pypa.io/get-pip.py | python \
    && curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"

WORKDIR /workspace
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --extra xraydar --no-install-project
COPY src ./src
RUN uv sync --frozen --no-dev --extra xraydar
COPY . .
RUN chmod +x scripts/entrypoint.sh \
    && mkdir -p outputs \
    && ln -s /usr/local/lib/libggml-cuda.so /usr/local/bin/libggml-cuda.so \
    && ln -s /usr/local/lib/libggml-cpu-haswell.so /usr/local/bin/libggml-cpu-haswell.so
